
@model mvc_project.Models.logincls

@{
    ViewBag.Title = "Tenant Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:40px; margin-bottom:40px;">

    <div class="text-center">
        <h2>Available Properties</h2>
        <hr />
    </div>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h4 class="text-center" style="margin:5px;">Search Rental Properties</h4>
        </div>

        <div class="panel-body">
            @using (Html.BeginForm("search_click", "searchrental", FormMethod.Post))
            {
                <div class="row">

                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Location</label>
                            @Html.TextBox("location", null, new { @class = "form-control", placeholder = "Enter location" })
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Bedrooms</label>
                            @Html.TextBox("bedrooms", null, new { @class = "form-control", type = "number", min = "1", placeholder = "Number of bedrooms" })
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Maximum Rent</label>
                            @Html.TextBox("rent", null, new { @class = "form-control", type = "number", min = "0", placeholder = "Maximum rent" })
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-block">
                                Search
                            </button>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

    @if (ViewBag.userdetails != null && ViewBag.userdetails.Count > 0)
    {
        <div class="panel panel-primary">

            <div class="panel-heading">
                <h4 class="text-center" style="margin:5px;">Property Details</h4>
            </div>

            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Location</th>
                                <th>Rent</th>
                                <th>Bedrooms</th>
                                <th>Bathrooms</th>
                                <th>Area</th>
                                <th>Photo 1</th>
                                <th>Photo 2</th>
                                <th>Available From</th>
                                <th>Lease Duration</th>
                                <th>Apply</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in ViewBag.userdetails)
                            {
                                <tr>
                                    <td>@item.property_title</td>
                                    <td>@item.description</td>
                                    <td>@item.location</td>
                                    <td>₹@item.rent</td>
                                    <td>@item.bedrooms</td>
                                    <td>@item.bathrooms</td>
                                    <td>@item.area</td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.photo1))
                                        {
                                            <img src="@Url.Content(item.photo1)"
                                                 class="img-thumbnail"
                                                 style="width:100px; height:80px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.photo2))
                                        {
                                            <img src="@Url.Content(item.photo2)"
                                                 class="img-thumbnail"
                                                 style="width:100px; height:80px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image</span>
                                        }
                                    </td>

                                    <td>@item.available_from</td>
                                    <td>@item.lease_duration</td>

                                    <td>
                                        @Html.ActionLink(
                                            "Apply",
                                            "application_pageload",
                                            "rentalapplication",
                                            new { id = item.property_id },
                                            new { @class = "btn btn-success btn-sm" }
                                        )
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h4>No properties are currently available.</h4>
            <p>Try changing your search filters to find other properties.</p>
        </div>
    }

</div>
