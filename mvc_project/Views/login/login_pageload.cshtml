
@model mvc_project.Models.logincls

@{
    ViewBag.Title = "login_pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:60px; margin-bottom:60px;">
    <div class="row">
        <div class="col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">

            <div class="panel panel-primary">
                <div class="panel-heading text-center">
                    <h3 style="margin:5px;">Login</h3>
                </div>

                <div class="panel-body" style="padding:30px;">

                    @using (Html.BeginForm("login_click", "login", FormMethod.Post))
                    {
                        <div class="form-horizontal">

                            <div class="form-group">
                                @Html.LabelFor(m => m.uname, "Username", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.uname, new { @class = "form-control", placeholder = "Enter your username" })
                                    @Html.ValidationMessageFor(m => m.uname, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.pw, "Password", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.PasswordFor(m => m.pw, new { @class = "form-control", placeholder = "Enter your password" })
                                    @Html.ValidationMessageFor(m => m.pw, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-sm-offset-4 col-sm-8 text-center">
                                    <input type="submit" value="Login" class="btn btn-primary btn-lg" />
                                </div>
                            </div>

                            <div class="text-center text-danger">
                                @Html.DisplayFor(m => m.msg)
                            </div>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
