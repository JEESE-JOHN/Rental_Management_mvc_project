
@model mvc_project.Models.tenantregcls

@{
    ViewBag.Title = "tenantreg_pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:40px; margin-bottom:40px;">
    <div class="row">
        <div class="col-md-8 col-md-offset-2 col-lg-8 col-lg-offset-2">

            <div class="panel panel-primary">
                <div class="panel-heading text-center">
                    <h3 style="margin:5px;">Tenant Registration</h3>
                </div>

                <div class="panel-body" style="padding:30px;">

                    @using (Html.BeginForm("tenantreg_click", "tenantreg", FormMethod.Post))
                    {
                        <div class="form-horizontal">

                            <div class="form-group">
                                @Html.LabelFor(m => m.name, "Name", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.name, new { @class = "form-control", placeholder = "Enter your name" })
                                    @Html.ValidationMessageFor(m => m.name, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.age, "Age", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.age, new { @class = "form-control", placeholder = "Enter your age" })
                                    @Html.ValidationMessageFor(m => m.age, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.email, "Email", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.email, new { @class = "form-control", placeholder = "Enter your email" })
                                    @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.phone, "Phone", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.phone, new { @class = "form-control", placeholder = "Enter your phone number" })
                                    @Html.ValidationMessageFor(m => m.phone, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.address, "Address", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextAreaFor(m => m.address, new { @class = "form-control", rows = "3", placeholder = "Enter your address" })
                                    @Html.ValidationMessageFor(m => m.address, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.occupation, "Occupation", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.occupation, new { @class = "form-control", placeholder = "Enter your occupation" })
                                    @Html.ValidationMessageFor(m => m.occupation, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.username, "Username", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(m => m.username, new { @class = "form-control", placeholder = "Choose a username" })
                                    @Html.ValidationMessageFor(m => m.username, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.pass, "Password", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.PasswordFor(m => m.pass, new { @class = "form-control", placeholder = "Enter your password" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.cpassword, "Confirm Password", new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.PasswordFor(m => m.cpassword, new { @class = "form-control", placeholder = "Confirm your password" })
                                    @Html.ValidationMessageFor(m => m.cpassword, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-sm-offset-4 col-sm-8 text-center">
                                    <input type="submit" value="Register Tenant" class="btn btn-primary btn-lg" />
                                </div>
                            </div>

                            <div class="text-center text-success">
                                @Html.DisplayFor(m => m.tenantmsg)
                            </div>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>